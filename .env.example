# 앱이 감싸는 모바일 웹 주소.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
# 주의: EXPO_PUBLIC_ 접두사 값은 JS 번들에 그대로 인라인됩니다.
# 비밀값(API 키, 토큰)은 절대 넣지 마세요.
EXPO_PUBLIC_WEB_URL=https://m.plick.co.kr

# ─────────────────────────────────────────────────────────────
# 로컬 개발 웹에 붙일 때
# ─────────────────────────────────────────────────────────────
# 실행 환경에 따라 "localhost"가 가리키는 곳이 다릅니다. 아래에서 골라 쓰세요.
#
#   iOS 시뮬레이터      EXPO_PUBLIC_WEB_URL=http://localhost:3001
#   Android 에뮬레이터  EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3001
#                       ← 에뮬레이터 안의 localhost는 "에뮬레이터 자신"입니다.
#                         10.0.2.2 가 호스트 맥을 가리키는 특수 주소입니다.
#   실기기(같은 Wi-Fi)  EXPO_PUBLIC_WEB_URL=http://192.168.0.10:3001
#                       ← 맥의 LAN IP. 확인: ipconfig getifaddr en0
#                         개발 서버가 127.0.0.1이 아니라 0.0.0.0에 바인딩돼 있어야 합니다.
#
# HTTP(암호화 없는) 주소는 기본적으로 차단됩니다. 로컬 개발 중에만 아래를 켜세요.
# iOS는 로컬/사설망에 한해 허용되고(app.config.ts의 NSAllowsLocalNetworking),
# 안드로이드는 이 플래그가 usesCleartextTraffic 을 켭니다.
#
# 이 값을 바꾼 뒤에는 네이티브 설정이 다시 생성되어야 반영됩니다:
#   npx expo prebuild --clean && npm run ios   (또는 npm run android)
#
# ALLOW_CLEARTEXT_TRAFFIC=1
